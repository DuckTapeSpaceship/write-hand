{
  "name": "write-hand",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Draw your handwriting in the browser and get an OpenType font.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "lab": "vite --open /lab/",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "sh scripts/e2e-docker.sh",
    "fixtures": "vitest run tests/fixtures.build.test.ts",
    "verify": "node scripts/verify.mjs",
    "e2e:local": "playwright test --project=desktop --project=pixel7 --project=lab"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.18.8",
    "@types/opentype.js": "1.3.8",
    "harfbuzzjs": "1.6.2",
    "jsdom": "30.1.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "clipper2-ts": "2.0.1-18",
    "idb-keyval": "6.3.0",
    "opentype.js": "1.3.4",
    "perfect-freehand": "1.2.3"
  }
}
